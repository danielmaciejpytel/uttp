# ---- speed converter through jumps and landings (mm/speedconv_air.hpp, MapConfig::speedConverter kLanding; off by default) ----
add_executable(utpp_speedconv_air_test tests/SpeedConv_airTest.cpp src/mm/speedconv_air.hpp src/mm/SpeedConverter.hpp)
target_compile_options(utpp_speedconv_air_test PRIVATE ${UTPP_WARNINGS} /EHsc)
target_compile_features(utpp_speedconv_air_test PRIVATE cxx_std_20)
add_test(NAME utpp_speedconv_air_test COMMAND utpp_speedconv_air_test)
# mutation 60: no landing scope (must FAIL its touch-down check)
add_executable(utpp_speedconv_air_test_mut60 tests/SpeedConv_airTest.cpp src/mm/speedconv_air.hpp)
target_compile_options(utpp_speedconv_air_test_mut60 PRIVATE ${UTPP_WARNINGS} /EHsc)
target_compile_features(utpp_speedconv_air_test_mut60 PRIVATE cxx_std_20)
target_compile_definitions(utpp_speedconv_air_test_mut60 PRIVATE UTPP_SPEED_CONVERTER_MUTATION=60)
add_test(NAME utpp_speedconv_air_test_mut60 COMMAND utpp_speedconv_air_test_mut60)
set_tests_properties(utpp_speedconv_air_test_mut60 PROPERTIES PASS_REGULAR_EXPRESSION "FAIL landing: the landing scope converts the touch-down feed")
# mutation 61: the flight heading is not kept on touch-down (must FAIL its heading check)
add_executable(utpp_speedconv_air_test_mut61 tests/SpeedConv_airTest.cpp src/mm/speedconv_air.hpp)
target_compile_options(utpp_speedconv_air_test_mut61 PRIVATE ${UTPP_WARNINGS} /EHsc)
target_compile_features(utpp_speedconv_air_test_mut61 PRIVATE cxx_std_20)
target_compile_definitions(utpp_speedconv_air_test_mut61 PRIVATE UTPP_SPEED_CONVERTER_MUTATION=61)
add_test(NAME utpp_speedconv_air_test_mut61 COMMAND utpp_speedconv_air_test_mut61)
set_tests_properties(utpp_speedconv_air_test_mut61 PROPERTIES PASS_REGULAR_EXPRESSION "FAIL landing: touch-down keeps the flight heading")
# mutation 62: the touch-down velocity is always trusted (must FAIL its spike check)
add_executable(utpp_speedconv_air_test_mut62 tests/SpeedConv_airTest.cpp src/mm/speedconv_air.hpp)
target_compile_options(utpp_speedconv_air_test_mut62 PRIVATE ${UTPP_WARNINGS} /EHsc)
target_compile_features(utpp_speedconv_air_test_mut62 PRIVATE cxx_std_20)
target_compile_definitions(utpp_speedconv_air_test_mut62 PRIVATE UTPP_SPEED_CONVERTER_MUTATION=62)
add_test(NAME utpp_speedconv_air_test_mut62 COMMAND utpp_speedconv_air_test_mut62)
set_tests_properties(utpp_speedconv_air_test_mut62 PROPERTIES PASS_REGULAR_EXPRESSION "FAIL landing spike: the reversed touch-down feeds convert along the flight heading")
