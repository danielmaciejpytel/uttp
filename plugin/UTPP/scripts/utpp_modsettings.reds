  @runtimeProperty("ModSettings.category", "General")
  @runtimeProperty("ModSettings.category.order", "1")
  @runtimeProperty("ModSettings.order", "4")
  @runtimeProperty("ModSettings.displayName", "Shooter mode")
  @runtimeProperty("ModSettings.description", "Third-person-shooter style movement relative to the camera. Standing still: V does not turn when you turn the camera (you orbit around her). When V moves, aims or shoots she turns with the start / turn / pivot animations (one smooth turn, no spin) until she faces where the camera looks; she then runs forward, side-steps (70 % of the run speed) or backpedals (60 %) with the strafe animations. Sprint works only roughly forward. Off = V turns toward the movement direction (body turn). No effect with the Game Animations pack.")
  public let bodyturn_shooterMode: Bool = false;

  // perspective.startInLastView
  @runtimeProperty("ModSettings.mod", "Ultimate Third Person")
  @runtimeProperty("ModSettings.category", "General")
  @runtimeProperty("ModSettings.category.order", "1")
  @runtimeProperty("ModSettings.order", "5")
  @runtimeProperty("ModSettings.displayName", "Start in the last used view")
  @runtimeProperty("ModSettings.description", "On: the game starts in the view you used last. Off: the game always starts in third person (default: on).")
  public let perspective_startInLastView: Bool = true;

