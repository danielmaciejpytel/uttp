<Project Sdk="Microsoft.NET.Sdk">
  <!-- Offline bridge to the local WolvenKit.CLI 9.0.1 assemblies (loaded by reflection from Tools\WolvenKit.CLI):
       glTF animation import into an existing .anims (GltfImportArgs.ImportFormat = Anims), game archives read-only. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>disable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RollForward>LatestMinor</RollForward>
  </PropertyGroup>
</Project>
