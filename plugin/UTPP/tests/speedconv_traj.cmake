# ---- speed converter, query prediction from the converted state (mm/speedconv_traj.hpp, MapConfig::speedConverter bit 256) ----
add_executable(utpp_speedconv_traj_test tests/SpeedConv_trajTest.cpp src/mm/speedconv_traj.hpp src/mm/SpeedConverter.hpp src/mm/MotionTrajectory.hpp)
target_compile_options(utpp_speedconv_traj_test PRIVATE ${UTPP_WARNINGS} /EHsc)
target_compile_features(utpp_speedconv_traj_test PRIVATE cxx_std_20)
add_test(NAME utpp_speedconv_traj_test COMMAND utpp_speedconv_traj_test)
# mutation 30: the plain prediction always (must FAIL the sharp-turn check)
add_executable(utpp_speedconv_traj_test_mut30 tests/SpeedConv_trajTest.cpp src/mm/speedconv_traj.hpp)
target_compile_options(utpp_speedconv_traj_test_mut30 PRIVATE ${UTPP_WARNINGS} /EHsc)
target_compile_features(utpp_speedconv_traj_test_mut30 PRIVATE cxx_std_20)
target_compile_definitions(utpp_speedconv_traj_test_mut30 PRIVATE UTPP_SPEED_CONVERTER_MUTATION=30)
add_test(NAME utpp_speedconv_traj_test_mut30 COMMAND utpp_speedconv_traj_test_mut30)
set_tests_properties(utpp_speedconv_traj_test_mut30 PROPERTIES PASS_REGULAR_EXPRESSION "FAIL traj hook: the converted prediction replaces the plain one")
# mutation 31: the prediction starts from the game velocity (must FAIL the converted-heading check)
add_executable(utpp_speedconv_traj_test_mut31 tests/SpeedConv_trajTest.cpp src/mm/speedconv_traj.hpp)
target_compile_options(utpp_speedconv_traj_test_mut31 PRIVATE ${UTPP_WARNINGS} /EHsc)
target_compile_features(utpp_speedconv_traj_test_mut31 PRIVATE cxx_std_20)
target_compile_definitions(utpp_speedconv_traj_test_mut31 PRIVATE UTPP_SPEED_CONVERTER_MUTATION=31)
add_test(NAME utpp_speedconv_traj_test_mut31 COMMAND utpp_speedconv_traj_test_mut31)
set_tests_properties(utpp_speedconv_traj_test_mut31 PROPERTIES PASS_REGULAR_EXPRESSION "FAIL traj predict: the prediction starts along the converted heading")
# mutation 32: the current game speed over the whole horizon (must FAIL the speed-ramp check)
add_executable(utpp_speedconv_traj_test_mut32 tests/SpeedConv_trajTest.cpp src/mm/speedconv_traj.hpp)
target_compile_options(utpp_speedconv_traj_test_mut32 PRIVATE ${UTPP_WARNINGS} /EHsc)
target_compile_features(utpp_speedconv_traj_test_mut32 PRIVATE cxx_std_20)
target_compile_definitions(utpp_speedconv_traj_test_mut32 PRIVATE UTPP_SPEED_CONVERTER_MUTATION=32)
add_test(NAME utpp_speedconv_traj_test_mut32 COMMAND utpp_speedconv_traj_test_mut32)
set_tests_properties(utpp_speedconv_traj_test_mut32 PROPERTIES PASS_REGULAR_EXPRESSION "FAIL traj ramp: the converted prediction keeps the speed of the plain prediction")
