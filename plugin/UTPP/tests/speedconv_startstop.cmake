# ---- speed converter, starts and stops (mm/speedconv_startstop.hpp, MapConfig::speedConverter bit speedconv::kStartStopWindow) ----
# Included from plugin/UTPP/CMakeLists.txt; expects UTPP_WARNINGS. No data files.
add_executable(utpp_speedconv_startstop_test tests/SpeedConv_startstopTest.cpp src/mm/speedconv_startstop.hpp src/mm/MotionAdapter.hpp)
target_compile_options(utpp_speedconv_startstop_test PRIVATE ${UTPP_WARNINGS} /EHsc)
target_compile_features(utpp_speedconv_startstop_test PRIVATE cxx_std_20)
add_test(NAME utpp_speedconv_startstop_test COMMAND utpp_speedconv_startstop_test)
# mutation 10: no start / stop window (must FAIL the start check)
add_executable(utpp_speedconv_startstop_mut10 tests/SpeedConv_startstopTest.cpp src/mm/speedconv_startstop.hpp)
target_compile_options(utpp_speedconv_startstop_mut10 PRIVATE ${UTPP_WARNINGS} /EHsc)
target_compile_features(utpp_speedconv_startstop_mut10 PRIVATE cxx_std_20)
target_compile_definitions(utpp_speedconv_startstop_mut10 PRIVATE UTPP_SPEED_CONVERTER_MUTATION=10)
add_test(NAME utpp_speedconv_startstop_mut10 COMMAND utpp_speedconv_startstop_mut10)
set_tests_properties(utpp_speedconv_startstop_mut10 PROPERTIES PASS_REGULAR_EXPRESSION "FAIL start: the converted speed follows the reference acceleration")
# mutation 11: the hand-off jumps back to the turn converter's speed (must FAIL the hand-off check)
add_executable(utpp_speedconv_startstop_mut11 tests/SpeedConv_startstopTest.cpp src/mm/speedconv_startstop.hpp)
target_compile_options(utpp_speedconv_startstop_mut11 PRIVATE ${UTPP_WARNINGS} /EHsc)
target_compile_features(utpp_speedconv_startstop_mut11 PRIVATE cxx_std_20)
target_compile_definitions(utpp_speedconv_startstop_mut11 PRIVATE UTPP_SPEED_CONVERTER_MUTATION=11)
add_test(NAME utpp_speedconv_startstop_mut11 COMMAND utpp_speedconv_startstop_mut11)
set_tests_properties(utpp_speedconv_startstop_mut11 PROPERTIES PASS_REGULAR_EXPRESSION "FAIL start: the hand-off has no speed jump")
