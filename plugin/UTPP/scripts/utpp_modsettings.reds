// UTPP - options of the Mod Settings screen (mod "Ultimate Third Person"). GENERATED by tools/settings/gen_modsettings.py from the CET
// settings registry (utpp_core 0.5.5) - do not edit; change the CET registration and run the generator.
// The CET registry applies every option; utpp_core syncs these values both ways through utpp_modsettings_bridge.reds.
// Without the Mod Settings framework the class is unused and the options stay in the Native Settings tab.
// Defaults equal the registry's, except options with a negative default (redscript has no negative initializer): their
// class default is 0 (marked below), which Mod Settings' "Restore defaults" shows; the first sync pushes the CET value.

// animation.pack: 0 = utpp, 1 = game
enum UTPPMS_animation_pack {
  UltimateThirdPersonProject = 0,
  GameAnimations = 1
}

// core.diagnosticLogs: 0 = off, 1 = timed, 2 = until
enum UTPPMS_core_diagnosticLogs {
  Off = 0,
  OnFor5Minutes = 1,
  OnUntilSwitchedOff = 2
}

// perspective.aiming: 0 = fpp, 1 = tpp
enum UTPPMS_perspective_aiming {
  FirstPerson = 0,
  ThirdPerson = 1
}

// perspective.aimingScoped: 0 = fpp, 1 = tpp
enum UTPPMS_perspective_aimingScoped {
  FirstPerson = 0,
  ThirdPerson = 1
}

// perspective.combat: 0 = tpp, 1 = fpp
enum UTPPMS_perspective_combat {
  ThirdPerson = 0,
  FirstPerson = 1
}

// perspective.weaponDrawn: 0 = tpp, 1 = fpp
enum UTPPMS_perspective_weaponDrawn {
  ThirdPerson = 0,
  FirstPerson = 1
}

// crosshair.color: 0 = standard, 1 = white, 2 = red, 3 = green, 4 = black
enum UTPPMS_crosshair_color {
  Standard = 0,
  White = 1,
  Red = 2,
  Green = 3,
  Black = 4
}

public class UTPPModSettings extends IScriptable {

  // camera.impl
  @runtimeProperty("ModSettings.mod", "Ultimate Third Person")
  @runtimeProperty("ModSettings.category", "General")
  @runtimeProperty("ModSettings.category.order", "1")
  @runtimeProperty("ModSettings.order", "1")
  @runtimeProperty("ModSettings.displayName", "Use Ultimate Third Person")
  @runtimeProperty("ModSettings.description", "On: the mod's own third-person camera. Off: the game's first-person view only (the third-person camera needs utpp_camera.archive + .xl).")
  public let camera_impl: Bool = true;

