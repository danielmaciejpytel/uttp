  public final func UTPPSnapshot() -> String {
    let s: String = "";
    s += "camera_impl=" + UTPPMSBool(this.camera_impl) + "\n";
    s += "animation_pack=" + IntToString(EnumInt(this.animation_pack)) + "\n";
    s += "perspective_impl=" + UTPPMSBool(this.perspective_impl) + "\n";
    s += "bodyturn_shooterMode=" + UTPPMSBool(this.bodyturn_shooterMode) + "\n";
    s += "perspective_startInLastView=" + UTPPMSBool(this.perspective_startInLastView) + "\n";
    s += "core_diagnosticLogs=" + IntToString(EnumInt(this.core_diagnosticLogs)) + "\n";
    s += "camera_distance=" + UTPPMSFloat(this.camera_distance) + "\n";
    s += "camera_side=" + UTPPMSFloat(this.camera_side) + "\n";
    s += "camera_fov=" + UTPPMSFloat(this.camera_fov) + "\n";
    s += "camera_height=" + UTPPMSFloat(this.camera_height) + "\n";
    s += "camera_sens=" + UTPPMSFloat(this.camera_sens) + "\n";
    s += "camera_invertX=" + UTPPMSBool(this.camera_invertX) + "\n";
    s += "camera_invertY=" + UTPPMSBool(this.camera_invertY) + "\n";
    s += "camera_zoomUnarmed_enabled=" + UTPPMSBool(this.camera_zoomUnarmed_enabled) + "\n";
    s += "mm_headLead=" + UTPPMSBool(this.mm_headLead) + "\n";
    s += "mm_walkSpeed=" + UTPPMSFloat(this.mm_walkSpeed) + "\n";
    s += "mm_shoulderWidth=" + UTPPMSFloat(this.mm_shoulderWidth) + "\n";
    s += "camera_idleOrbit=" + UTPPMSBool(this.camera_idleOrbit) + "\n";
    s += "camera_followHoldOnFlip=" + UTPPMSBool(this.camera_followHoldOnFlip) + "\n";
    s += "perspective_animate=" + UTPPMSBool(this.perspective_animate) + "\n";
    s += "perspective_blend=" + UTPPMSFloat(this.perspective_blend) + "\n";
    s += "camera_audio=" + UTPPMSBool(this.camera_audio) + "\n";
    s += "perspective_aiming=" + IntToString(EnumInt(this.perspective_aiming)) + "\n";
    s += "perspective_aimingScoped=" + IntToString(EnumInt(this.perspective_aimingScoped)) + "\n";
    s += "perspective_combat=" + IntToString(EnumInt(this.perspective_combat)) + "\n";
    s += "perspective_weaponDrawn=" + IntToString(EnumInt(this.perspective_weaponDrawn)) + "\n";
    s += "mm_shinobiBonusReload=" + UTPPMSBool(this.mm_shinobiBonusReload) + "\n";
    s += "crosshair_impl=" + UTPPMSBool(this.crosshair_impl) + "\n";
    s += "crosshair_color=" + IntToString(EnumInt(this.crosshair_color)) + "\n";
    s += "melee_fullBody=" + UTPPMSBool(this.melee_fullBody) + "\n";
    s += "melee_aimTilt=" + UTPPMSBool(this.melee_aimTilt) + "\n";
    s += "perspective_shortScopeFpp=" + UTPPMSBool(this.perspective_shortScopeFpp) + "\n";
    s += "camera_aim_enabled=" + UTPPMSBool(this.camera_aim_enabled) + "\n";
    s += "camera_aim_distance=" + UTPPMSFloat(this.camera_aim_distance) + "\n";
    s += "camera_aim_side=" + UTPPMSFloat(this.camera_aim_side) + "\n";
    s += "camera_aim_zoomFov=" + UTPPMSBool(this.camera_aim_zoomFov) + "\n";
    s += "camera_aim_fov=" + UTPPMSFloat(this.camera_aim_fov) + "\n";
    s += "camera_aim_autoSwap=" + UTPPMSBool(this.camera_aim_autoSwap) + "\n";
    s += "camera_aimReturn=" + UTPPMSBool(this.camera_aimReturn) + "\n";
    s += "camera_aimReturnBlend=" + UTPPMSFloat(this.camera_aimReturnBlend) + "\n";
    s += "perspective_combatCut=" + UTPPMSBool(this.perspective_combatCut) + "\n";
    s += "perspective_combatExit=" + UTPPMSFloat(this.perspective_combatExit) + "\n";
    s += "perspective_meleeBlockTpp=" + UTPPMSBool(this.perspective_meleeBlockTpp) + "\n";
    s += "perspective_takedown=" + UTPPMSBool(this.perspective_takedown) + "\n";
    s += "perspective_scene=" + UTPPMSBool(this.perspective_scene) + "\n";
    s += "lootView_impl=" + UTPPMSBool(this.lootView_impl) + "\n";
    s += "interactRange_impl=" + UTPPMSBool(this.interactRange_impl) + "\n";
    s += "headLook_impl=" + UTPPMSBool(this.headLook_impl) + "\n";
    s += "headLook_faceCamera=" + UTPPMSBool(this.headLook_faceCamera) + "\n";
    s += "lootRange_impl=" + UTPPMSBool(this.lootRange_impl) + "\n";
    s += "perspective_sceneExit=" + UTPPMSFloat(this.perspective_sceneExit) + "\n";
    s += "perspective_interaction=" + UTPPMSBool(this.perspective_interaction) + "\n";
    s += "perspective_interactionExit=" + UTPPMSFloat(this.perspective_interactionExit) + "\n";
    s += "perspective_workspot=" + UTPPMSBool(this.perspective_workspot) + "\n";
    s += "perspective_traversal=" + UTPPMSBool(this.perspective_traversal) + "\n";
    s += "perspective_scanner=" + UTPPMSBool(this.perspective_scanner) + "\n";
    s += "perspective_vehicleKeepTpp=" + UTPPMSBool(this.perspective_vehicleKeepTpp) + "\n";
    s += "vehicle_forceTppOnEnter=" + UTPPMSBool(this.vehicle_forceTppOnEnter) + "\n";
    s += "vehicle_approachWalk=" + UTPPMSBool(this.vehicle_approachWalk) + "\n";
    s += "vehicle_jumpOutSidePush=" + UTPPMSBool(this.vehicle_jumpOutSidePush) + "\n";
    s += "camera_zoomUnarmed_steps=" + IntToString(this.camera_zoomUnarmed_steps) + "\n";
    s += "camera_zoomUnarmed_distance=" + UTPPMSFloat(this.camera_zoomUnarmed_distance) + "\n";
    s += "camera_zoomUnarmed_lastDistance=" + UTPPMSFloat(this.camera_zoomUnarmed_lastDistance) + "\n";
    s += "camera_zoomUnarmed_fppHandoff=" + UTPPMSBool(this.camera_zoomUnarmed_fppHandoff) + "\n";
    return s;
  }
