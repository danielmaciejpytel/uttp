  @runtimeProperty("ModSettings.order", "3")
  @runtimeProperty("ModSettings.displayName", "Use UTPP automatic perspective")
  @runtimeProperty("ModSettings.description", "Switches between first and third person by situation.")
  public let perspective_impl: Bool = true;

  // bodyturn.shooterMode
